# ── Decision engine (required) ─────────────────────────────────────
# Get a key at https://console.typesafe.ai
JEV_API_KEY=your-api-key-here
JEV_MODEL=type-safe/jev-latest
JEV_BASE_URL=https://ai-gateway.vercel.sh/v1

# ── Explanation provider (LLM) ─────────────────────────────────────
# Supported: openrouter | vercel | none
LLM_PROVIDER=vercel

# Vercel AI Gateway — https://vercel.com/docs/ai-gateway
# Model uses gateway routing syntax, e.g. openai/gpt-4o-mini
VERCEL_AI_GATEWAY_API_KEY=
VERCEL_AI_GATEWAY_MODEL=type-safe/jev-latest
VERCEL_AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# OpenRouter (alternative LLM provider)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Application ────────────────────────────────────────────────────
# Comma-separated allow-list for CORS (browsers block absent origins).
# For a local Chrome extension (MV3 service worker sends Origin: chrome-extension://<id>)
# CHROME_EXTENSION_ID=abc... put chrome-extension://<ID> here:
CORS_ORIGINS=
LOG_LEVEL=INFO
# Optional shared-secret the extension must send as X-API-Key; empty = auth off
API_KEY=
